FROM python:3.12-slim

# deploy-bump: 2026-06-28-driver-portal-panel1 — mini painel motorista
ARG NEXUS_GIT_COMMIT=dev
ARG NEXUS_CACHE_BUST=2026.06.28-driver-portal-panel1

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NEXUS_BIND_HOST=0.0.0.0 \
    INTEGRACAO_GATEWAY_HOST=0.0.0.0 \
    NEXUS_DEPLOY_TARGET=sistema \
    NEXUS_SISTEMA_UI=web \
    NEXUS_GIT_COMMIT=${NEXUS_GIT_COMMIT}

LABEL org.nexus.deploy="sistema-master" \
      org.nexus.port="8770"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY . .

RUN echo "${NEXUS_CACHE_BUST}" > /app/.nexus_cache_bust

RUN echo "========== NEXUS DOCKER BUILD STAMP ==========" \
    && grep APP_BUILD app/version.py \
    && cat /app/.nexus_cache_bust \
    && echo "=============================================="

RUN python -c "\
from pathlib import Path;\
rec = Path('app/master/routers/web/receptions.py');\
svc = Path('app/master/services/reception_service.py');\
assert rec.is_file(), 'FALTA receptions.py';\
assert svc.is_file(), 'FALTA reception_service.py';\
print('OK: modulo Receptivos')\
"

RUN python -c "\
from pathlib import Path;\
res = Path('app/master/templates/master/reservations');\
assert (res / 'form.html').is_file(), 'FALTA form.html';\
assert not (res / 'form_edit.html').is_file(), 'REMOVER form_edit.html';\
src = Path('app/master/routers/web/reservations.py').read_text(encoding='utf-8');\
assert 'master/reservations/form.html' in src, 'router deve usar form.html';\
assert 'form_edit.html' not in src, 'router nao pode usar form_edit.html';\
assert 'reservation_to_form_dict' in src, 'router precisa reservation_to_form_dict';\
print('OK: formulario reserva unificado')\
"

RUN python -c "import re; p=open('app/version.py', encoding='utf-8').read(); m=re.search(r'APP_BUILD\\s*=\\s*[\"\\']([^\"\\']+)[\"\\']', p); open('.nexus_app_build','w', encoding='utf-8').write(m.group(1) if m else 'unknown')" \
    && echo "${NEXUS_GIT_COMMIT}" > /app/.nexus_git_commit

RUN mv /usr/local/bin/uvicorn /usr/local/bin/_uvicorn_motor \
    && cp scripts/uvicorn_wrapper.sh /usr/local/bin/uvicorn \
    && sed -i 's/\r$//' /usr/local/bin/uvicorn \
    && chmod 755 /usr/local/bin/uvicorn \
    && echo "sistema-master-8770" > /app/.nexus_build_target \
    && echo "web-only" > /app/.nexus_sistema_ui

RUN adduser --disabled-password --gecos "" appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8770 8772 8765 8766

HEALTHCHECK --interval=30s --timeout=15s --start-period=45s --retries=3 \
  CMD python -c "import urllib.request; \
urllib.request.urlopen('http://127.0.0.1:8770/api/v1/public/statistics'); \
urllib.request.urlopen('http://127.0.0.1:8772/api/health'); \
urllib.request.urlopen('http://127.0.0.1:8765/'); \
urllib.request.urlopen('http://127.0.0.1:8766/')" || exit 1

ENTRYPOINT ["python", "scripts/docker_entrypoint.py"]
